# SurfaceForge Configuration
# Copy this file to .env and fill in your values.
# This file is auto-loaded on startup. Never commit the real .env to git.

# === LLM Provider ===
# DeepSeek (default, cheapest for reasoning)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Multi-provider pool (optional, overrides above):
# Format: name|base_url|api_key|model,name2|base2|key2|model2
# LLM_PROVIDERS=deepseek|https://api.deepseek.com|sk-xxx|deepseek-chat,openai|https://api.openai.com/v1|sk-yyy|gpt-4o

# === SignalHarbor (news summarizer, optional) ===
# DEEPSEEK_API_KEY=

# === WebUI ===
WEBUI_PASSWORD=changeme-at-least-16chars
WEBUI_ADMIN_PASSWORD=changeme-at-least-16chars
WEBUI_SESSION_SECRET=changeme-at-least-32-characters-long-secret
WEBUI_PORT=8088
# WEBUI_HOST=127.0.0.1

# === SRC Agent defaults ===
SRC_MAX_CYCLES=20
SRC_MAX_EXPLORE=3
SRC_DELAY_SECONDS=1.0
# SRC_REASONER_PREFER=deepseek
# SRC_EXPLORER_PREFER=

# === Feishu (optional) ===
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_TRUSTED_USERS=
