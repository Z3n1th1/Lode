# ---- 密钥 / 本地配置(绝不入库)----
.env
.env.local
*.key
*.pem

# ---- 运行时状态 / 本机挖洞数据(含目标信息,不入库)----
lode-state/
lode-state-smoke/
projects/
runtime-smoke/
.delivery-smoke/
src-agent-runs/
src-autopilot-data/
out-*/
# --out-dir 的默认值就是 ./out(lode.py 的 scan/auto 两个子命令),里面是真实目标的
# surface 数据(paths/scripts/fingerprints)。上面那行只挡了 out-*,漏了默认目录。
out/
# 本机跑真实目标用的 scope 文档与目标清单(仓库里已有的 scope-anduril/eternal/k8s
# 是历史遗留,别按它们的样子继续往里加)。
scope-nba.json
targets-nba-hot.txt

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/
*.lock

# ---- Node / 前端 ----
node_modules/
dist/

# ---- 杂项 ----
resp4.json
.DS_Store

# ---- 本机工具/临时环境(带平台相关二进制,不入库)----
.tools/
