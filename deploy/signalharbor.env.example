# Copy to /etc/signalharbor/signalharbor.env and chmod 0600.
# Keep secrets out of the registry, command line, git, and journal.
DEEPSEEK_MODEL=deepseek-flash
# Optional: without this key Pulse keeps English source text; with it, one
# bounded batch per two-hour digest adds Chinese title and summary.
DEEPSEEK_API_KEY=
# Optional one-way Feishu delivery is enabled only with an explicit --feishu flag.
FEISHU_WEBHOOK=
FEISHU_SECRET=
# Optional official X API Bearer Token. The X watchlist stays disabled until
# the registry entry is explicitly enabled.
X_BEARER_TOKEN=
# Optional Discord delivery: add --discord to the service command.
DISCORD_WEBHOOK=
